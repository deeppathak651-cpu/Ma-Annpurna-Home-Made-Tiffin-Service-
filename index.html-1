<div id="locationConfirmModal"
     style="display:none;position:fixed;inset:0;z-index:99999;
            background:rgba(0,0,0,.72);align-items:center;justify-content:center;
            padding:20px;">
  <div style="width:min(440px,100%);background:#123b56;border:2px solid #55d7ff;
              border-radius:20px;padding:22px;box-shadow:0 12px 40px rgba(0,0,0,.45);">
    <div style="font-size:24px;font-weight:800;color:#65d7ff;margin-bottom:8px;">
      📍 Confirm Your Location
    </div>
    <div style="font-size:15px;color:#dcecf5;line-height:1.45;margin-bottom:12px;">
      Kya aap is current location ko delivery address ke liye use karna chahte hain?
    </div>
    <div id="locationConfirmAddress"
         style="background:#0b2b45;border-radius:12px;padding:12px;
                color:#f6d98b;font-size:14px;line-height:1.4;margin-bottom:16px;
                word-break:break-word;">
      Location detected.
    </div>
    <div style="display:flex;gap:10px;">
      <button id="locationCancelBtn" type="button" class="secondary" style="flex:1;">
        Cancel
      </button>
      <button id="locationConfirmBtn" type="button" class="primary" style="flex:1;">
        ✅ Confirm
      </button>
    </div>
  </div>
</div>

<script src="https://www.gstatic.com/firebasejs/12.19.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/12.19.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore-compat.js"></script>
<script>
/* Firebase compatibility bridge: keeps the app's modular-style code working
   when this HTML is opened directly from a phone/downloads folder. */
function initializeApp(config){ return firebase.initializeApp(config); }
function getAuth(app){ return firebase.auth(app); }
function onAuthStateChanged(auth, cb){ return auth.onAuthStateChanged(cb); }
function createUserWithEmailAndPassword(auth,email,password){ return auth.createUserWithEmailAndPassword(email,password); }
function signInWithEmailAndPassword(auth,email,password){ return auth.signInWithEmailAndPassword(email,password); }
function sendPasswordResetEmail(auth,email,settings){ return auth.sendPasswordResetEmail(email,settings); }
function sendEmailVerification(user){ return user.sendEmailVerification(); }
function signOut(auth){ return auth.signOut(); }
function updateProfile(user,data){ return user.updateProfile(data); }
function getFirestore(app){ return firebase.firestore(app); }
function collection(db,path){ return db.collection(path); }
function doc(db,path,id){ return db.collection(path).doc(id); }
function getDoc(ref){ return ref.get(); }
function setDoc(ref,data,options){ return ref.set(data,options||{}); }
function addDoc(ref,data){ return ref.add(data); }
function updateDoc(ref,data){ return ref.update(data); }
function deleteDoc(ref){ return ref.delete(); }
function onSnapshot(ref,cb){ return ref.onSnapshot(cb); }
function where(field,op,value){ return {field,op,value}; }
function query(ref,...constraints){
  return constraints.reduce((q,c)=>q.where(c.field,c.op,c.value),ref);
}
function getDocs(ref){ return ref.get(); }
function serverTimestamp(){ return firebase.firestore.FieldValue.serverTimestamp(); }
</script>
<script>

/* If Firebase/CDN loading fails, show the reason instead of leaving dead buttons. */
window.addEventListener("error", function(e){
  if(e && e.message && e.message !== "Script error." && /Firebase|firebase|module|undefined|ReferenceError/i.test(e.message)){
    var box=document.getElementById("authMessage");
    if(box){ box.textContent="App startup error: "+e.message; box.className="message show error"; }
  }
});
window.addEventListener("unhandledrejection", function(e){
  var msg=e && e.reason ? (e.reason.message||String(e.reason)) : "Unknown error";
  var box=document.getElementById("authMessage");
  if(box){ box.textContent="App error: "+msg; box.className="message show error"; }
});

