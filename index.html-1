/* =========================================================
   CURRENT LOCATION
========================================================= */

let pendingLocation = null;

function setLocationStatus(message, type){
  const el = $("locationStatus");
  if(!el) return;
  el.style.display = "block";
  el.className = "message show " + (type || "info");
  el.textContent = message;
}

function closeLocationConfirm(){
  const modal = $("locationConfirmModal");
  if(modal) modal.style.display = "none";
}

async function reverseGeocode(lat, lon){
  try{
    const response = await fetch(
      "https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat="
      + encodeURIComponent(lat)
      + "&lon=" + encodeURIComponent(lon)
      + "&zoom=18&addressdetails=1",
      {
        headers:{ "Accept":"application/json" }
      }
    );

    if(!response.ok) return "";

    const data = await response.json();
    return data && data.display_name ? data.display_name : "";
  }catch(error){
    return "";
  }
}

window.getCurrentLocation = function(){

  const button = $("useCurrentLocationBtn");

  if(!navigator.geolocation){
    setLocationStatus(
      "Location is not supported by this browser/app.",
      "error"
    );
    return;
  }

  if(button){
    button.disabled = true;
    button.textContent = "📍 Requesting Location...";
  }

  setLocationStatus(
    "📍 Please allow Location permission in the popup...",
    "info"
  );

  /*
    IMPORTANT:
    Do NOT use Permissions API to decide whether to request GPS.
    On Android, if permission was previously denied, Permissions API
    can return 'denied' without showing a popup. The direct
    getCurrentPosition() call below is the actual permission request.
  */
  navigator.geolocation.getCurrentPosition(
    async function(position){

      const latitude = Number(position.coords.latitude);
      const longitude = Number(position.coords.longitude);

      $("authLatitude").value = latitude.toFixed(7);
      $("authLongitude").value = longitude.toFixed(7);

      let readableAddress = "";

      try{
        readableAddress = await reverseGeocode(latitude, longitude);
      }catch(error){
        readableAddress = "";
      }

      pendingLocation = {
        latitude: latitude,
        longitude: longitude,
        address: readableAddress
      };

      const confirmAddress = $("locationConfirmAddress");

      if(confirmAddress){
        confirmAddress.textContent =
          readableAddress ||
          ("GPS Location: " +
           latitude.toFixed(6) + ", " +
           longitude.toFixed(6));
      }

      const modal = $("locationConfirmModal");

      if(modal){
        modal.style.display = "flex";
      }

      setLocationStatus(
        "📍 Location found. Please Confirm.",
        "info"
      );

      if(button){
        button.disabled = false;
        button.textContent = "📍 Use My Current Location";
      }
    },

    function(error){

      if(button){
        button.disabled = false;
        button.textContent = "📍 Use My Current Location";
      }

      /*
        Android/Chrome returns PERMISSION_DENIED when the site/app
        permission is already blocked. JavaScript cannot force the
        Android system permission popup again. Give a clear action
        instead of appearing to do nothing.
      */
      if(error && error.code === 1){

        setLocationStatus(
          "📍 Location permission is blocked for this app/site. " +
          "Open phone Settings → Apps → your app/browser → Permissions → Location → Allow, " +
          "then come back and tap this button again.",
          "error"
        );

        return;
      }

      if(error && error.code === 2){
        setLocationStatus(
          "📍 Location unavailable. Turn ON phone Location/GPS and tap the button again.",
          "error"
        );
        return;
      }

      if(error && error.code === 3){
        setLocationStatus(
          "📍 Location request timed out. Keep GPS/Location ON and try again.",
          "error"
        );
        return;
      }

      setLocationStatus(
        "📍 Could not get your location. Please try again.",
        "error"
      );
    },

    {
      enableHighAccuracy: true,
      timeout: 30000,
      maximumAge: 0
    }
  );
};


document.addEventListener("click", function(event){

  if(event.target && event.target.id === "locationCancelBtn"){
    pendingLocation = null;
    closeLocationConfirm();
    setLocationStatus(
      "Location not confirmed. You can enter your address manually.",
      "info"
    );
  }

  if(event.target && event.target.id === "locationConfirmBtn"){

    if(!pendingLocation) return;

    $("authLatitude").value = pendingLocation.latitude.toFixed(7);
    $("authLongitude").value = pendingLocation.longitude.toFixed(7);

    if(pendingLocation.address){
      $("authAddress").value = pendingLocation.address;
      $("authAddress").dispatchEvent(
        new Event("input",{bubbles:true})
      );
    }

    closeLocationConfirm();

    setLocationStatus(
      "✅ Current location confirmed successfully.",
      "success"
    );

    pendingLocation = null;
  }
});

/* =========================================================
   REGISTER
========================================================= */

window.registerUser =
async function(){

  if(selectedAuthRole === "admin"){
    showMessage("Admin accounts cannot be created from public Sign Up.","error");
    return;
  }

  const firstName=$("authFirstName").value.trim();
  const lastName=$("authLastName").value.trim();
  const phone=$("authPhone").value.trim();
  const email=$("authEmail").value.trim().toLowerCase();
  const address=$("authAddress").value.trim();
  const latitude=$("authLatitude").value.trim();
  const longitude=$("authLongitude").value.trim();
  const password=$("authSignupPassword").value;
  const confirmPassword=$("authConfirmPassword").value;

  if(!firstName || !lastName || !phone || !email || !password || !confirmPassword){
    showMessage("Please complete all required fields.","error");
    return;
  }

  if(selectedAuthRole === "customer" && !address){
    showMessage("Please enter your complete delivery address or use Current Location.","error");
    return;
  }

  if(!/^[0-9]{10}$/.test(phone)){
    showMessage("Please enter a valid 10-digit mobile number.","error");
    return;
  }

  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
    showMessage("Please enter a valid email address.","error");
    return;
  }

  // Password policy: minimum 6 characters and must contain uppercase, lowercase, number, and special character.
  const passwordPolicy = /^(?=.*[A-Z])(?=.*[a-z])(?=.*\d)(?=.*[^A-Za-z0-9]).{6,}$/;
  if(!passwordPolicy.test(password)){
    showMessage("Password must be at least 6 characters and include an uppercase letter, a lowercase letter, a number, and a special character.","error");
    return;
  }

  if(password !== confirmPassword){
    showMessage("Passwords do not match.","error");
    return;
  }

  let credential=null;

  try{
    /*
      IMPORTANT: Do not query the users collection before authentication.
      The previous code did that and Firestore rules correctly rejected the
      unauthenticated read with "Missing or insufficient permissions".
    */
    showMessage("Creating your account...","info");

    credential=await createUserWithEmailAndPassword(auth,email,password);

    const uid=credential.user.uid;
    const role=selectedAuthRole;
    const status=role === "customer" ? "approved" : "pending";

    await updateProfile(credential.user,{displayName:firstName+" "+lastName});

    await setDoc(doc(db,"users",uid),{
      uid:uid,
      firstName:firstName,
      lastName:lastName,
      name:firstName+" "+lastName,
      phone:phone,
      email:email,
      address:address,
      location: (latitude && longitude) ? {
        latitude:Number(latitude),
        longitude:Number(longitude)
      } : null,
      role:role,
      status:status,
      emailVerified:false,
      permissions:{menu:false,orders:false,delivery:false},
      createdAt:serverTimestamp()
    });

    /* Send verification email immediately after successful registration. */
    await sendEmailVerification(credential.user);

    showMessage(
      role === "customer"
        ? "Account created successfully. Please check your email and verify your email address before signing in."
        : "Account created successfully. Please verify your email. Staff access will be available after admin approval.",
      "success"
    );

    if($("resendVerificationWrap")) $("resendVerificationWrap").style.display="block";
    if($("authLogin")) $("authLogin").value=email;
    showLoginBox();

    /* Sign out so the unverified account does not enter a panel automatically. */
    await signOut(auth);

  }catch(error){
    const code=error && error.code ? String(error.code) : "unknown";
    let msg="Unable to create the account. Please try again.";

    if(code === "auth/email-already-in-use") msg="An account with this email already exists. Please sign in or reset the password.";
    else if(code === "auth/invalid-email") msg="Please enter a valid email address.";
    else if(code === "auth/weak-password") msg="Password must be at least 6 characters.";
    else if(code === "auth/network-request-failed") msg="Network error. Check your internet connection and try again.";
    else if(code === "permission-denied") msg="Your account was created, but the profile could not be saved because of a Firebase permission rule. Please contact the administrator.";
    else if(error && error.message) msg=error.message;

    showMessage(msg,"error");

    /* If Firestore profile creation failed after Auth creation, remove the
       just-created Auth user so the next attempt is not blocked by a ghost account. */
    if(credential && credential.user && code === "permission-denied"){
      try{ await credential.user.delete(); }catch(_e){}
    }
  }
};


/* =========================================================
   PASSWORD RESET
========================================================= */

window.resetPassword =
async function(){
  const email=$("authLogin").value.trim().toLowerCase();

  if(!email || !email.includes("@")){
    showMessage("Enter the email address linked to your account first.","error");
    return;
  }

  try{
    showMessage("Sending password reset email...","info");
    await sendPasswordResetEmail(auth,email);
    showMessage("Password reset email sent. Check your Inbox, Spam, Promotions, and All Mail for the reset link.","success");
  }catch(error){
    const code=error && error.code ? String(error.code) : "unknown";
    let msg="Unable to send the password reset email.";
    if(code === "auth/user-not-found") msg="No account was found for this email address.";
    else if(code === "auth/invalid-email") msg="Please enter a valid email address.";
    else if(code === "auth/too-many-requests") msg="Too many reset requests. Please wait and try again later.";
    else if(code === "auth/network-request-failed") msg="Network error. Check your internet connection and try again.";
    else if(error && error.message) msg=error.message;
    showMessage(msg,"error");
  }
};

window.resetAdminPassword=window.resetPassword;

window.resendVerificationEmail=async function(){
  const email=$("authLogin").value.trim().toLowerCase();
  const password=$("authPassword").value;
  if(!email || !email.includes("@")){
    showMessage("Enter the email address used for registration.","error");
    return;
  }
  try{
    showMessage("Signing in securely to resend the verification email...","info");
    const cred=await signInWithEmailAndPassword(auth,email,password);
    if(cred.user.emailVerified){
      showMessage("This email address is already verified. You can sign in normally.","success");
      return;
    }
    await sendEmailVerification(cred.user);
    showMessage("Verification email sent again. Please check your Inbox, Spam, Promotions, and All Mail.","success");
    await signOut(auth);
  }catch(error){
    const code=error && error.code ? String(error.code) : "unknown";
    let msg="Unable to resend the verification email.";
    if(code === "auth/invalid-credential") msg="The email or password is incorrect.";
    else if(code === "auth/user-not-found") msg="No account was found for this email address.";
    else if(code === "auth/too-many-requests") msg="Too many requests. Please wait and try again later.";
    else if(error && error.message) msg=error.message;
    showMessage(msg,"error");
  }
};


/* =========================================================
   LOGIN
========================================================= */

window.loginUser =
async function(){

  const loginValue=$("authLogin").value.trim().toLowerCase();
  const password=$("authPassword").value;

  if(!loginValue || !password){
    showMessage("Please enter your email address and password.","error");
    return;
  }

  if(!loginValue.includes("@")){
    showMessage("Please use the email address linked to your account to sign in.","error");
    return;
  }

  try{
    showMessage("Signing in...","info");
    const credential=await signInWithEmailAndPassword(auth,loginValue,password);
    const user=credential.user;

    const snap=await getDoc(doc(db,"users",user.uid));
    if(!snap.exists){
      await signOut(auth);
      showMessage("Your account profile could not be found. Please contact support.","error");
      return;
    }

    const profile=snap.data() || {};
    const role=String(profile.role || "customer").trim().toLowerCase();

    /* Admin login is not blocked by email verification so the existing
       administrator account can be recovered and used immediately. */
    if(role !== "admin" && !user.emailVerified){
      if($("resendVerificationWrap")) $("resendVerificationWrap").style.display="block";
      await signOut(auth);
      showMessage("Please verify your email address before signing in. We have sent a verification link to your email.","error");
      return;
    }

    if($("resendVerificationWrap")) $("resendVerificationWrap").style.display="none";

  }catch(error){
    const code=error && error.code ? String(error.code) : "unknown";
    let msg="Unable to sign in. Please check your email and password.";

    if(code === "auth/invalid-credential") msg="The email or password is incorrect.";
    else if(code === "auth/user-not-found") msg="No account was found for this email address.";
    else if(code === "auth/wrong-password") msg="The password is incorrect.";
    else if(code === "auth/invalid-email") msg="Please enter a valid email address.";
    else if(code === "auth/user-disabled") msg="This account has been disabled. Please contact support.";
    else if(code === "auth/too-many-requests") msg="Too many sign-in attempts. Please wait and try again later.";
    else if(code === "auth/network-request-failed") msg="Network error. Check your internet connection and try again.";
    else if(code === "permission-denied") msg="Your account is signed in, but its profile cannot be read because of a Firebase permission rule.";
    else if(error && error.message) msg=error.message;

    showMessage(msg,"error");
  }
};


selectAuthRole("customer");


/* =========================================================
   AUTH STATE
========================================================= */

onAuthStateChanged(
  auth,
  async user=>{

    if(!user){

      currentUser=null;
      currentUserData=null;
      currentRole="customer";

      $("mainNav")
        .classList.add("hidden");

      showPage("auth");

      return;
    }


    currentUser =
      user;


    try{

      const snap =
        await getDoc(
          doc(db,"users",user.uid)
        );


      if(!snap.exists){

        await signOut(auth);

        showPage("auth");

        showMessage(
          "Your account profile could not be found. Please contact support.",
          "error"
        );

        return;
      }


      currentUserData =
        snap.data();


      currentRole =
        String(currentUserData.role || "customer").trim().toLowerCase();


      /*
       * IMPORTANT:
       * Login karne wale user ko
       * sirf uska apna panel milega.
       */

      openRolePanel();


    }catch(error){

      console.error(error);

      showMessage(
        "Unable to load your account profile. Please try again.",
        "error"
      );

    }

  }
);


/* =========================================================
   ROLE ROUTING
========================================================= */

function openRolePanel(){

  /*
   * Sab pages hide
   */

  document
    .querySelectorAll(".page")
    .forEach(page=>{
      page.classList.remove("active");
    });


  /*
   * Customer navigation default hidden
   */

  $("mainNav")
    .classList.add("hidden");


  /* ================= ADMIN ================= */

  if(currentRole === "admin"){

    showPage("admin");

    loadAdmin();

    return;
  }


  /* ================= RESTAURANT ================= */

  if(currentRole === "restaurant"){

    if(currentUserData.status !== "approved"){

      showPage("staffPending");

      return;
    }

    showPage("restaurant");

    loadRestaurant();

    return;
  }


  /* ================= DELIVERY ================= */

  if(currentRole === "delivery"){

    if(currentUserData.status !== "approved"){

      showPage("staffPending");

      return;
    }

    showPage("delivery");

    loadDelivery();

    return;
  }


  /* ================= CUSTOMER ================= */

  currentRole="customer";

  $("mainNav")
    .classList.remove("hidden");

  showPage("home");

  loadCustomer();

}


/* =========================================================
   LOGOUT
========================================================= */

window.logoutUser =
async function(){

  await signOut(auth);

  location.reload();

};


/* =========================================================
   CUSTOMER
========================================================= */

async function loadCustomer(){

  loadMenu();

  loadCustomerOrders();

  loadProfile();

  $("homeOffer").textContent =
    offerText;

}


/* =========================================================
   MENU LOAD
========================================================= */

function loadMenu(){

  onSnapshot(
    collection(db,"foods"),
    snapshot=>{

      menuItems =
        snapshot.docs.map(d=>({
          id:d.id,
          ...d.data()
        }));


      renderMenu();

      renderAdminMenu();

      $("statFoods").textContent =
        menuItems.length;

    },
    error=>{
      console.error(error);
    }
  );

}


/* =========================================================
   RENDER MENU
========================================================= */

function renderMenu(){

  const box =
    $("menuList");

  if(!box) return;


  if(menuItems.length === 0){

    box.innerHTML =
      "<p>No menu items available.</p>";

    return;
  }


  box.innerHTML =
    menuItems.map(item=>`

      <div class="menu-card">

        <div class="menu-emoji">
          ${escapeHtml(item.emoji || "🍱")}
        </div>

        <h3>
          ${escapeHtml(item.name)}
        </h3>

        <div class="price">
          ₹${Number(item.price || 0)}
        </div>

        <button
          onclick="addToCart('${item.id}')">
          🛒 Add
        </button>

      </div>

    `).join("");


  $("homePopular").innerHTML =
    menuItems.slice(0,3)
    .map(item=>`

      <div class="home-action">

        <b>
          ${escapeHtml(item.emoji || "🍱")}
          ${escapeHtml(item.name)}
        </b>

        — ₹${Number(item.price || 0)}

      </div>

    `).join("");

}


/* =========================================================
   CART
========================================================= */

window.addToCart =
function(id){

  const item =
    menuItems.find(x=>x.id===id);

  if(!item) return;


  const existing =
    cartItems.find(x=>x.id===id);


  if(existing){

    existing.qty++;

  }else{

    cartItems.push({
      ...item,
      qty:1
    });

  }


  renderCart();

  showPage("cart");

};


function renderCart(){

  const box =
    $("cartList");

  if(!box) return;


  if(cartItems.length===0){

    box.innerHTML =
      "<p>🛒 Cart empty hai.</p>";

    $("cartTotal").textContent="0";

    return;
  }


  let total=0;


  box.innerHTML =
    cartItems.map((item,index)=>{

      const line =
        Number(item.price || 0) *
        item.qty;

      total += line;


      return `

        <div class="card">

          <b>
            ${escapeHtml(item.emoji || "🍱")}
            ${escapeHtml(item.name)}
          </b>

          <p>
            ₹${item.price} × ${item.qty}
            = ₹${line}
          </p>

          <div class="qty-row">

            <button
              class="small-btn"
              onclick="changeQty(${index},-1)">
              −
            </button>

            <span class="qty">
              ${item.qty}
            </span>

            <button
              class="small-btn"
              onclick="changeQty(${index},1)">
              +
            </button>

            <button
              class="danger small-btn"
              onclick="removeCart(${index})">
              Remove
            </button>

          </div>

        </div>

      `;

    }).join("");


  $("cartTotal").textContent =
    total;

}


window.changeQty =
function(index,change){

  cartItems[index].qty += change;

  if(cartItems[index].qty<=0){

    cartItems.splice(index,1);

  }

  renderCart();

};


window.removeCart =
function(index){

  cartItems.splice(index,1);

  renderCart();

};


/* =========================================================
   PLACE ORDER
========================================================= */

window.placeOrder =
async function(){

  if(!currentUser){

    return;
  }


  if(cartItems.length===0){

    alert("Cart empty hai.");

    return;
  }


  if(!shopOpen){

    alert("Shop abhi CLOSED hai.");

    return;
  }


  const address =
    currentUserData.address || "";


  const total =
    cartItems.reduce(
      (sum,item)=>
        sum +
        Number(item.price||0)*item.qty,
      0
    );


  try{

    await addDoc(
      collection(db,"orders"),
      {

        userId:
          currentUser.uid,

        customerName:
          currentUserData.name || "",

        customerPhone:
          currentUserData.phone || "",

        address:address,

        customerLocation: currentUserData.location || null,

        items:
          cartItems.map(item=>({
            id:item.id,
            name:item.name,
            price:item.price,
            qty:item.qty
          })),

        total:total,

        status:
          "Order Received",

        deliveryId:"",

        createdAt:
          serverTimestamp()

      }
    );


    cartItems=[];

    renderCart();

    alert(
      "Order successfully place ho gaya."
    );

    showPage("orders");

    loadCustomerOrders();


  }catch(error){

    alert(error.message);

  }

};


/* =========================================================
   CUSTOMER ORDERS
========================================================= */

function loadCustomerOrders(){

  if(!currentUser) return;


  const q =
    query(
      collection(db,"orders"),
      where("userId","==",currentUser.uid)
    );


  onSnapshot(
    q,
    snapshot=>{

      const box =
        $("customerOrders");

      if(!box) return;


      if(snapshot.empty){

        box.innerHTML =
          "<p>Abhi koi order nahi hai.</p>";

        return;
      }


      box.innerHTML =
        snapshot.docs.map(d=>{

          const o =
            d.data();


          return `

            <div class="card">

              <b>
                🧾 Order
              </b>

              <p>
                Total: ₹${Number(o.total||0)}
              </p>

              <span class="status">
                ${escapeHtml(o.status || "")}
              </span>

            </div>

          `;

        }).join("");

    }
  );

}


