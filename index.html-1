  ["customerTab","restaurantTab","deliveryTab","adminTab"].forEach(id=>{
    const el=$(id);
    if(el) el.classList.remove("active");
  });

  const loginInput=$("authLogin");
  if(loginInput){
    loginInput.type="email";
    loginInput.name="email";
    loginInput.autocomplete="email";
    loginInput.inputMode="email";
    loginInput.autocapitalize="none";
    loginInput.spellcheck=false;
  }

  if($("adminEmailQuickFill")) $("adminEmailQuickFill").style.display="none";
  if($("adminResetButtonWrap")) $("adminResetButtonWrap").style.display="none";
  if($("generalResetButtonWrap")) $("generalResetButtonWrap").style.display="block";
  if($("resendVerificationWrap")) $("resendVerificationWrap").style.display="none";

  if(role === "customer"){
    $("customerTab").classList.add("active");
    $("loginTitle").textContent="👤 Customer Sign In";
    $("signupTitle").textContent="✨ Customer Sign Up";
    $("staffSignupNote").style.display="none";
    $("customerSignupButton").style.display="block";
  }else if(role === "restaurant"){
    $("restaurantTab").classList.add("active");
    $("loginTitle").textContent="🍳 Restaurant Sign In";
    $("signupTitle").textContent="🍳 Restaurant Sign Up";
    $("staffSignupNote").style.display="block";
    $("customerSignupButton").style.display="block";
  }else if(role === "delivery"){
    $("deliveryTab").classList.add("active");
    $("loginTitle").textContent="🛵 Delivery Sign In";
    $("signupTitle").textContent="🛵 Delivery Sign Up";
    $("staffSignupNote").style.display="block";
    $("customerSignupButton").style.display="block";
  }else if(role === "admin"){
    $("adminTab").classList.add("active");
    $("loginTitle").textContent="👑 Admin Sign In";
    $("customerSignupButton").style.display="none";
    $("staffSignupNote").style.display="none";
    $("loginBox").style.display="block";
    $("signupBox").style.display="none";

    loginInput.value="deepakpathak651@gmail.com";
    loginInput.type="email";
    loginInput.name="email";
    loginInput.autocomplete="email";
    loginInput.inputMode="email";
    loginInput.autocapitalize="none";
    loginInput.spellcheck=false;

    $("adminEmailQuickFill").style.display="block";
    $("adminResetButtonWrap").style.display="block";
