/* =========================================================
   PERMISSION
========================================================= */

window.changePermission =
async function(uid,permission,value){

  if(currentRole!=="admin")
    return;


  const snap =
    await getDoc(
      doc(db,"users",uid)
    );


  if(!snap.exists) return;


  const data =
    snap.data();


  const permissions =
    data.permissions || {};


  permissions[permission] =
    value;


  await updateDoc(
    doc(db,"users",uid),
    {
      permissions:permissions
    }
  );

};


/* =========================================================
   CHANGE ROLE
========================================================= */

window.changeRole =
async function(uid){

  if(currentRole!=="admin")
    return;


  const role =
    prompt(
      "New role: customer / restaurant / delivery / admin"
    );


  if(
    !role ||
    ![
      "customer",
      "restaurant",
      "delivery",
      "admin"
    ].includes(role)
  ){

    return;
  }


  await updateDoc(
    doc(db,"users",uid),
    {
      role:role
    }
  );

};


/* =========================================================
   ADMIN USERS
========================================================= */

function loadAdminUsers(){

  onSnapshot(
    collection(db,"users"),
    snapshot=>{

      const box=$("adminUsers");
      if(!box) return;

      const users=snapshot.docs.map(d=>({
        id:d.id,
        ...d.data()
      }));

      box.innerHTML=users.map(u=>{

        const role=u.role||"customer";
        const disabled=u.status==="disabled";

        return `
          <div class="card">
            <b>👤 ${escapeHtml(u.name||"User")}</b>
            <p>📱 ${escapeHtml(u.phone||"")}</p>
            <p>📧 ${escapeHtml(u.email||"")}</p>
            <p>Role: <span class="status">${escapeHtml(role)}</span>
              ${disabled?'<span class="status disabled">DISABLED</span>':''}
            </p>
            <div class="two-grid">
              <button class="${disabled?'success':'danger'} small-btn"
                onclick="setCustomerStatus('${u.id}','${disabled?'active':'disabled'}')">
                ${disabled?'✅ Enable':'🚫 Disable'}
              </button>
              <button class="dark small-btn"
                onclick="adminChangeUserRole('${u.id}')">
                🔄 Change Role
              </button>
            </div>
          </div>
        `;

      }).join("") || "<p>No users found.</p>";

      const customers=users.filter(u=>(u.role||"customer")==="customer").length;
      const restaurants=users.filter(u=>u.role==="restaurant").length;
      const deliveries=users.filter(u=>u.role==="delivery").length;
      const pending=users.filter(u=>(u.role==="restaurant"||u.role==="delivery") && u.status!=="approved").length;

      if($("statUsers")) $("statUsers").textContent=users.length;
      if($("statCustomers")) $("statCustomers").textContent=customers;
      if($("statRestaurant")) $("statRestaurant").textContent=restaurants;
      if($("statDelivery")) $("statDelivery").textContent=deliveries;
      if($("statPending")) $("statPending").textContent=pending;
    }
  );

}

/* =========================================================
   ADMIN ORDERS
========================================================= */

function loadAdminOrders(){

  onSnapshot(
    collection(db,"orders"),
    async snapshot=>{

      const box =
        $("adminOrders");


      const deliveryUsers =
        await getDeliveryUsers();


      box.innerHTML =
        snapshot.docs.map(d=>{

          const o =
            d.data();


          const options =
            deliveryUsers.map(u=>`

              <option
                value="${u.id}"
                ${o.deliveryId===u.id ? "selected":""}>
                ${escapeHtml(u.name)}
              </option>

            `).join("");


          return `

            <div class="card">

              <b>
                🧾 ${escapeHtml(o.customerName || "")}
              </b>

              <p>
                📱 ${escapeHtml(o.customerPhone || "")}
              </p>

              <p>
                🏠 ${escapeHtml(o.address || "")}
              </p>

              <p>
                💰 ₹${Number(o.total||0)}
              </p>

              <p>
                Status:
                <span class="status">
                  ${escapeHtml(o.status || "")}
                </span>
              </p>


              <select
                onchange="assignDelivery('${d.id}',this.value)">

                <option value="">
                  🛵 Assign Delivery
                </option>

                ${options}

              </select>


              <br><br>


              <button
                class="small-btn"
                onclick="adminOrderStatus('${d.id}','Order Received')">
                Received
              </button>

              <button
                class="small-btn"
                onclick="adminOrderStatus('${d.id}','Preparing')">
                Preparing
              </button>

              <button
                class="success small-btn"
                onclick="adminOrderStatus('${d.id}','Ready for Pickup')">
                Ready
              </button>

              <button
                class="danger small-btn"
                onclick="adminOrderStatus('${d.id}','Cancelled')">
                Cancel
              </button>

            </div>

          `;

        }).join("");

    }
  );

}


/* =========================================================
   DELIVERY USERS
========================================================= */

async function getDeliveryUsers(){

  const q =
    query(
      collection(db,"users"),
      where("role","==","delivery"),
      where("status","==","approved")
    );


  const result =
    await getDocs(q);


  return result.docs.map(d=>({
    id:d.id,
    ...d.data()
  }));

}


