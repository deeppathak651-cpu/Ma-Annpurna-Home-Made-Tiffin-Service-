/* =========================================================
   ADMIN STATS
========================================================= */

function loadAdminStats(){

  onSnapshot(
    collection(db,"orders"),
    snapshot=>{

      $("statOrders").textContent =
        snapshot.size;


      let sales=0;

      snapshot.docs.forEach(d=>{

        const o=d.data();

        sales +=
          Number(o.total||0);

      });


      $("statSales").textContent =
        "₹"+sales;

    }
  );


  onSnapshot(
    collection(db,"users"),
    snapshot=>{

      $("statUsers").textContent =
        snapshot.size;

    }
  );

}


/* =========================================================
   ADMIN STAFF
========================================================= */

function loadAdminStaff(){

  onSnapshot(
    collection(db,"users"),
    snapshot=>{

      const box =
        $("staffList");

      const staff =
        snapshot.docs
        .map(d=>({
          id:d.id,
          ...d.data()
        }))
        .filter(u=>
          u.role==="restaurant" ||
          u.role==="delivery"
        );


      if(staff.length===0){

        box.innerHTML =
          "<p>No restaurant/delivery staff.</p>";

        return;
      }


      box.innerHTML =
        staff.map(u=>{

          const p =
            u.permissions || {};


          return `

            <div class="card">

              <h3>
                ${u.role==="restaurant" ? "🍳" : "🛵"}
                ${escapeHtml(u.name || "")}
              </h3>

              <p>
                📱 ${escapeHtml(u.phone || "")}
              </p>

              <p>
                📧 ${escapeHtml(u.email || "")}
              </p>

              <p>
                Status:
                <span class="status ${u.status}">
                  ${escapeHtml(u.status || "")}
                </span>
              </p>


              <div class="permission-box">

                <label>
                  <input
                    type="checkbox"
                    ${p.menu ? "checked":""}
                    onchange="changePermission('${u.id}','menu',this.checked)">
                  Menu
                </label>

                <label>
                  <input
                    type="checkbox"
                    ${p.orders ? "checked":""}
                    onchange="changePermission('${u.id}','orders',this.checked)">
                  Orders
                </label>

                <label>
                  <input
                    type="checkbox"
                    ${p.delivery ? "checked":""}
                    onchange="changePermission('${u.id}','delivery',this.checked)">
                  Delivery
                </label>

              </div>


              <button
                class="success small-btn"
                onclick="approveStaff('${u.id}')">
                ✅ Approve
              </button>

              <button
                class="danger small-btn"
                onclick="disableStaff('${u.id}')">
                🚫 Disable
              </button>

              <button
                class="dark small-btn"
                onclick="changeRole('${u.id}')">
                🔄 Role
              </button>

            </div>

          `;

        }).join("");

    }
  );

}


