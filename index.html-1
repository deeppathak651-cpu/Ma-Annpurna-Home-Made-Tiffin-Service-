        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminFoods').style.display='block';window.scrollTo(0,0);">🍱 Food Items</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminCategories').style.display='block';window.scrollTo(0,0);">📂 Categories</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminOrders').style.display='block';window.scrollTo(0,0);">📦 Orders</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminCustomers').style.display='block';window.scrollTo(0,0);">👤 Customers</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminPayments').style.display='block';window.scrollTo(0,0);">💳 Payments</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminDelivery').style.display='block';window.scrollTo(0,0);">🛵 Delivery</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminCoupons').style.display='block';window.scrollTo(0,0);">🎟️ Coupons</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminBanners').style.display='block';window.scrollTo(0,0);">🖼️ Banners</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminReviews').style.display='block';window.scrollTo(0,0);">⭐ Reviews</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminStaff').style.display='block';window.scrollTo(0,0);">👥 Staff</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminSettings').style.display='block';window.scrollTo(0,0);">⚙️ Settings</button>
        <button onclick="document.querySelectorAll('.admin-section').forEach(function(x){x.style.display='none'});document.getElementById('adminReports').style.display='block';window.scrollTo(0,0);">📈 Reports</button>
      </div>
    </div>

    <div id="adminDashboard" class="admin-section">
      <div class="banner">
        <h3>📊 Dashboard</h3>
        <div class="stats">
          <div class="stat"><b id="statOrders">0</b><span>Total Orders</span></div>
          <div class="stat"><b id="statSales">₹0</b><span>Total Sales</span></div>
          <div class="stat"><b id="statFoods">0</b><span>Food Items</span></div>
          <div class="stat"><b id="statUsers">0</b><span>Total Users</span></div>
          <div class="stat"><b id="statCustomers">0</b><span>Customers</span></div>
          <div class="stat"><b id="statRestaurant">0</b><span>Restaurant</span></div>
          <div class="stat"><b id="statDelivery">0</b><span>Delivery</span></div>
          <div class="stat"><b id="statPending">0</b><span>Pending</span></div>
        </div>
      </div>
      <div class="banner">
        <h3>🏪 Shop Control</h3>
        <div class="two-grid">
          <button class="success" onclick="setShopStatus(true)">🟢 OPEN</button>
          <button class="danger" onclick="setShopStatus(false)">🔴 CLOSED</button>
        </div>
      </div>
    </div>

    <div id="adminFoods" class="admin-section" style="display:none">
      <div class="banner">
        <h3>🍱 Unlimited Food Items</h3>
        <p>Jitne chahein food items add, edit, activate/deactivate ya delete karein.</p>
        <div class="auth-form-grid">
          <input id="foodName" placeholder="🍱 Food Name">
          <input id="foodPrice" type="number" min="0" placeholder="₹ Price">
          <input id="foodDiscount" type="number" min="0" placeholder="₹ Discount Price (optional)">
          <input id="foodEmoji" placeholder="🍛 Emoji">
          <input id="foodImage" placeholder="🖼️ Image URL (optional)">
          <input id="foodDescription" placeholder="📝 Description">
          <select id="foodCategory"><option value="">📂 Category</option></select>
          <select id="foodVeg"><option value="veg">🟢 Veg</option><option value="nonveg">🔴 Non-Veg</option></select>
          <label class="card"><input id="foodFeatured" type="checkbox"> ⭐ Featured</label>
          <label class="card"><input id="foodActive" type="checkbox" checked> ✅ Available</label>
          <button class="full" onclick="adminAddOrUpdateFood()">➕ Add Food Item</button>
          <button class="secondary full" onclick="cancelFoodEdit()">↩️ Clear / Cancel Edit</button>
        </div>
        <div id="adminMenuList"></div>
      </div>
    </div>

    <div id="adminCategories" class="admin-section" style="display:none">
      <div class="banner">
        <h3>📂 Categories</h3>
        <div class="two-grid">
          <input id="categoryName" placeholder="Category Name">
          <button onclick="adminAddCategory()">➕ Add Category</button>
        </div>
        <div id="categoryList"></div>
      </div>
    </div>

    <div id="adminOrders" class="admin-section" style="display:none">
      <div class="banner"><h3>📦 All Orders</h3><div id="adminOrdersList"></div></div>
    </div>

    <div id="adminCustomers" class="admin-section" style="display:none">
      <div class="banner"><h3>👤 Customer Management</h3><div id="adminUsers"></div></div>
    </div>

    <div id="adminPayments" class="admin-section" style="display:none">
      <div class="banner">
        <h3>💳 Payment Settings</h3>
        <div class="admin-control-grid">
          <input id="upiId" placeholder="UPI ID">
          <input id="bankName" placeholder="Bank Name">
          <input id="accountName" placeholder="Account Holder Name">
          <input id="accountNumber" placeholder="Account Number">
          <input id="ifscCode" placeholder="IFSC Code">
          <select id="paymentMode"><option value="both">COD + Online</option><option value="cod">COD Only</option><option value="online">Online Only</option></select>
        </div>
        <button class="full" onclick="savePaymentSettings()">💾 Save Payment Settings</button>
      </div>
    </div>

    <div id="adminDelivery" class="admin-section" style="display:none">
      <div class="banner">
        <h3>🛵 Delivery Settings</h3>
        <div class="admin-control-grid">
          <input id="deliveryCharge2" type="number" min="0" placeholder="Delivery Charge ₹">
          <input id="freeDeliveryAbove" type="number" min="0" placeholder="Free Delivery Above ₹">
          <input id="deliveryArea" placeholder="Service Areas">
          <input id="deliveryTime" placeholder="Delivery Time e.g. 45-60 min">
        </div>
        <button class="full" onclick="saveDeliverySettings()">💾 Save Delivery Settings</button>
      </div>
    </div>

    <div id="adminCoupons" class="admin-section" style="display:none">
