        <h3>🎟️ Coupons & Offers</h3>
        <div class="admin-control-grid">
          <input id="couponCode" placeholder="Coupon Code">
          <input id="couponDiscount" type="number" min="0" placeholder="Discount %">
          <input id="couponMinOrder" type="number" min="0" placeholder="Minimum Order ₹">
          <input id="couponExpiry" type="date">
        </div>
        <button class="full" onclick="adminAddCoupon()">➕ Add Coupon</button>
        <div id="couponList"></div>
      </div>
    </div>

    <div id="adminBanners" class="admin-section" style="display:none">
      <div class="banner">
        <h3>🖼️ Home Banners / Announcements</h3>
        <input id="bannerTitle" placeholder="Banner Title">
