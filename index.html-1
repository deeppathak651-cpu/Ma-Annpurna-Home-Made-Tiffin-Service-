/* =========================================================
   SHOP SETTINGS
========================================================= */

async function loadShopSettings(){

  try{

    const snap =
      await getDoc(
        doc(db,"settings","business")
      );


    if(snap.exists){

      const data =
        snap.data();


      shopOpen =
        data.shopOpen !== false;


      offerText =
        data.offer ||
        "Homemade food with love ❤️";

    }


    updateShopUI();


  }catch(error){

    console.log(error);

  }

}


function updateShopUI(){

  const status =
    $("shopStatus");


  if(!status) return;


  if(shopOpen){

    status.textContent="OPEN";

    status.classList.remove("closed");

  }else{

    status.textContent="CLOSED";

    status.classList.add("closed");

  }


  const offer =
    $("homeOffer");

  if(offer){

    offer.textContent =
      offerText;

  }

}


window.setShopStatus =
async function(open){

  if(currentRole!=="admin")
    return;


  shopOpen=open;


  await setDoc(
    doc(db,"settings","business"),
    {
      shopOpen:open,
      offer:offerText
    },
    {
      merge:true
    }
  );


  updateShopUI();

};


/* =========================================================
   OFFER
========================================================= */

window.saveOffer =
async function(){

  if(currentRole!=="admin")
    return;


  const value =
    $("offerText").value.trim();


  if(!value){

    alert(
      "Offer text डालें."
    );

    return;
  }


  offerText=value;


  await setDoc(
    doc(db,"settings","business"),
    {
      offer:offerText,
      shopOpen:shopOpen
    },
    {
      merge:true
    }
  );


  $("homeOffer").textContent =
    offerText;


  alert(
    "Offer saved."
  );

};



