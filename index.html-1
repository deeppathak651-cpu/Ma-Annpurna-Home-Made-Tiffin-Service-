  if(el) el.scrollIntoView({behavior:"smooth",block:"start"});
};

window.saveBusinessSettings=async function(){

  if(currentRole!=="admin") return;

  try{

    await setDoc(
      doc(db,"settings","business"),
      {
        businessName:($("businessName")?.value||"Maa Annapurna").trim(),
        serviceArea:($("serviceArea")?.value||"Haldwani Only").trim(),
        contactNumber:($("contactNumber")?.value||"").trim(),
        whatsappNumber:($("whatsappNumber")?.value||"").trim(),
        deliveryCharge:Number($("deliveryCharge")?.value||0),
        minOrder:Number($("minOrder")?.value||0),
        shopOpen:shopOpen,
        offer:offerText
      },
      {merge:true}
    );

    alert("Business settings save ho gayi.");

  }catch(e){
    alert("Settings save failed: "+e.message);
  }
};

window.setCustomerStatus=async function(uid,status){

  if(currentRole!=="admin") return;

  try{
    await updateDoc(
      doc(db,"users",uid),
      {status:status}
    );
  }catch(e){
    alert("User status update failed: "+e.message);
  }
};

window.adminChangeUserRole=async function(uid){

  if(currentRole!=="admin") return;

  const role=prompt(
    "Role चुनें: customer / restaurant / delivery / admin"
  );

  if(!["customer","restaurant","delivery","admin"].includes(role||"")){
    return;
  }

  try{
    await updateDoc(
      doc(db,"users",uid),
      {role:role}
    );
  }catch(e){
    alert("Role update failed: "+e.message);
  }
};

/* Restaurant panel: menu controls */
function renderRestaurantMenu(){

  const box=$("restaurantMenu");
  if(!box || currentRole!=="restaurant") return;

  const allowed=(currentUserData?.permissions||{}).menu;
  if(!allowed){
    box.innerHTML="";
    return;
  }

  box.innerHTML=`
    <div class="card">
      <h3>🍱 Menu Control</h3>
      <input id="restFoodName" placeholder="Food Name">
      <input id="restFoodPrice" type="number" placeholder="Price ₹">
      <input id="restFoodEmoji" placeholder="Emoji 🍱">
      <button class="full" onclick="restaurantAddFood()">➕ Add Food</button>
    </div>
    ${menuItems.map(item=>`
      <div class="card">
        <b>${escapeHtml(item.emoji||"🍱")} ${escapeHtml(item.name)}</b>
        <p>₹${Number(item.price||0)}</p>
        <button class="danger small-btn" onclick="restaurantDeleteFood('${item.id}')">🗑️ Delete</button>
      </div>
    `).join("")}
  `;
}

window.restaurantAddFood=async function(){

  if(currentRole!=="restaurant" || !currentUserData?.permissions?.menu) return;

  const name=($("restFoodName")?.value||"").trim();
  const price=Number($("restFoodPrice")?.value||0);
  const emoji=($("restFoodEmoji")?.value||"🍱").trim();

  if(!name || !price){
    alert("Food name aur price डालें.");
    return;
  }

  try{
    await addDoc(collection(db,"foods"),{
      name,price,emoji,active:true,createdAt:serverTimestamp()
    });
    renderRestaurantMenu();
  }catch(e){
    alert("Food add failed: "+e.message);
  }
};

window.restaurantDeleteFood=async function(id){

  if(currentRole!=="restaurant" || !currentUserData?.permissions?.menu) return;

  if(!confirm("Food delete karna hai?")) return;

  try{
    await deleteDoc(doc(db,"foods",id));
  }catch(e){
    alert("Delete failed: "+e.message);
  }
};

/* Make auth routing stop disabled accounts before opening any panel */
const originalOpenRolePanel = openRolePanel;
openRolePanel = function(){
  if(currentUserData?.status==="disabled"){
    alert("Ye account Admin ne disabled kiya hai.");
    signOut(auth);
    return;
  }
  return originalOpenRolePanel();
};

/* Ensure restaurant menu renders whenever menu data changes */
const originalRenderMenu = renderMenu;
renderMenu = function(){
  originalRenderMenu();
  if(currentRole==="restaurant") renderRestaurantMenu();
};



/* Admin navigation safety: buttons remain clickable above decorative layers. */
const adminNavStyle = document.createElement("style");
adminNavStyle.textContent = ".admin-quick-nav{position:relative;z-index:1000}.admin-quick-nav button{position:relative;z-index:1001;pointer-events:auto;cursor:pointer}";
document.head.appendChild(adminNavStyle);

/* =========================================================
   FULL ADMIN CONTROL CENTER EXTENSION
========================================================= */
let adminFoodEditId=null;

window.adminSection=function(name){
  // Navigation itself must always work while the Admin page is open.
  // Firestore security rules should protect the actual data operations.
  document.querySelectorAll(".admin-section").forEach(x=>x.style.display="none");
  const map={dashboard:"adminDashboard",foods:"adminFoods",categories:"adminCategories",orders:"adminOrders",customers:"adminCustomers",payments:"adminPayments",delivery:"adminDelivery",coupons:"adminCoupons",banners:"adminBanners",reviews:"adminReviews",staff:"adminStaff",settings:"adminSettings",reports:"adminReports"};
  const el=$(map[name]||"adminDashboard");
  if(el) el.style.display="block";
  if(name==="categories") loadAdminCategories();
  if(name==="foods"){loadAdminCategories();loadMenu();}
  if(name==="orders") loadAdminOrders();
  if(name==="payments") loadPaymentSettings();
  if(name==="delivery") loadDeliverySettings();
  if(name==="coupons") loadCoupons();
  if(name==="banners") loadBanners();
  if(name==="reports") generateAdminReport();
  window.scrollTo({top:0,behavior:"smooth"});
};

window.adminAddOrUpdateFood=async function(){
  if(currentRole!=="admin") return;
  const data={
    name:($("foodName")?.value||"").trim(),
    price:Number($("foodPrice")?.value||0),
    discountPrice:Number($("foodDiscount")?.value||0),
    emoji:($("foodEmoji")?.value||"🍱").trim(),
    image:($("foodImage")?.value||"").trim(),
    description:($("foodDescription")?.value||"").trim(),
    category:($("foodCategory")?.value||"").trim(),
    foodType:$("foodVeg")?.value||"veg",
    featured:!!$("foodFeatured")?.checked,
    active:$("foodActive")?.checked!==false,
    updatedAt:serverTimestamp()
  };
  if(!data.name || data.price<0){alert("Food name aur valid price डालें.");return;}
  try{
    if(adminFoodEditId) await updateDoc(doc(db,"foods",adminFoodEditId),data);
    else await addDoc(collection(db,"foods"),{...data,createdAt:serverTimestamp()});
    cancelFoodEdit(); loadMenu();
    alert(adminFoodEditId?"Food item updated.":"Food item added.");
  }catch(e){alert("Food save failed: "+e.message);}
};
window.editAdminFood=function(id){
  const item=menuItems.find(x=>x.id===id); if(!item)return;
  adminFoodEditId=id;
  $("foodName").value=item.name||"";$("foodPrice").value=item.price||0;$("foodDiscount").value=item.discountPrice||0;
  $("foodEmoji").value=item.emoji||"🍱";$("foodImage").value=item.image||"";$("foodDescription").value=item.description||"";
  $("foodCategory").value=item.category||"";$("foodVeg").value=item.foodType||"veg";$("foodFeatured").checked=!!item.featured;$("foodActive").checked=item.active!==false;
  adminSection("foods"); $("foodName").focus();
};
window.cancelFoodEdit=function(){
  adminFoodEditId=null;
  ["foodName","foodPrice","foodDiscount","foodEmoji","foodImage","foodDescription"].forEach(id=>{if($(id))$(id).value=""});
  if($("foodFeatured"))$("foodFeatured").checked=false;if($("foodActive"))$("foodActive").checked=true;
};
window.toggleAdminFood=async function(id,active){
  if(currentRole!=="admin")return; await updateDoc(doc(db,"foods",id),{active:active}); loadMenu();
};
window.deleteAdminFood=async function(id){
  if(currentRole!=="admin"||!confirm("Food item permanently delete karna hai?"))return;
  await deleteDoc(doc(db,"foods",id)); loadMenu();
};

window.adminAddCategory=async function(){
  if(currentRole!=="admin")return;
  const name=($("categoryName")?.value||"").trim(); if(!name){alert("Category name डालें.");return;}
  await addDoc(collection(db,"categories"),{name,active:true,createdAt:serverTimestamp()});
  $("categoryName").value="";loadAdminCategories();
};
async function loadAdminCategories(){
  const box=$("categoryList"), sel=$("foodCategory"); if(!box)return;
  onSnapshot(collection(db,"categories"),snap=>{
    const cats=snap.docs.map(d=>({id:d.id,...d.data()}));
    if(sel)sel.innerHTML='<option value="">📂 Category</option>'+cats.filter(c=>c.active!==false).map(c=>`<option value="${escapeHtml(c.name)}">${escapeHtml(c.name)}</option>`).join("");
    box.innerHTML=cats.map(c=>`<div class="card admin-item-row"><b>📂 ${escapeHtml(c.name)}</b><div class="admin-actions"><button class="small-btn ${c.active===false?'success':'danger'}" onclick="toggleCategory('${c.id}',${c.active===false})">${c.active===false?'Enable':'Disable'}</button><button class="danger small-btn" onclick="deleteCategory('${c.id}')">Delete</button></div></div>`).join("")||"<p>No categories.</p>";
  });
}
window.toggleCategory=async(id,a)=>{if(currentRole==="admin")await updateDoc(doc(db,"categories",id),{active:a});};
window.deleteCategory=async id=>{if(currentRole==="admin"&&confirm("Category delete karna hai?"))await deleteDoc(doc(db,"categories",id));};

function renderAdminMenu(){
 const box=$("adminMenuList"); if(!box)return;
 box.innerHTML=menuItems.map(item=>`<div class="card">
   <div><span class="menu-emoji">${escapeHtml(item.emoji||"🍱")}</span><b>${escapeHtml(item.name)}</b></div>
   <p>${escapeHtml(item.description||"")}</p>
   <p><b>₹${Number(item.price||0)}</b>${item.discountPrice?` &nbsp; Offer ₹${Number(item.discountPrice)}`:""} · ${escapeHtml(item.category||"No Category")} · ${item.active===false?"Unavailable":"Available"}</p>
   <div class="admin-actions">
    <button class="small-btn" onclick="editAdminFood('${item.id}')">✏️ Edit</button>
    <button class="small-btn ${item.active===false?'success':'secondary'}" onclick="toggleAdminFood('${item.id}',${item.active===false})">${item.active===false?'✅ Enable':'⏸️ Disable'}</button>
    <button class="danger small-btn" onclick="deleteAdminFood('${item.id}')">🗑️ Delete</button>
   </div></div>`).join("")||"<p>No food items yet.</p>";
}

async function savePaymentSettings(){
 if(currentRole!=="admin")return;
 await setDoc(doc(db,"settings","payments"),{upiId:$("upiId").value.trim(),bankName:$("bankName").value.trim(),accountName:$("accountName").value.trim(),accountNumber:$("accountNumber").value.trim(),ifscCode:$("ifscCode").value.trim(),paymentMode:$("paymentMode").value},{merge:true});
 alert("Payment settings saved.");
}
async function loadPaymentSettings(){const s=await getDoc(doc(db,"settings","payments"));if(!s.exists())return;const d=s.data();["upiId","bankName","accountName","accountNumber","ifscCode","paymentMode"].forEach(k=>{if($(k)&&d[k]!=null)$(k).value=d[k]});}

async function saveDeliverySettings(){
 if(currentRole!=="admin")return;
 await setDoc(doc(db,"settings","delivery"),{deliveryCharge:Number($("deliveryCharge2").value||0),freeDeliveryAbove:Number($("freeDeliveryAbove").value||0),deliveryArea:$("deliveryArea").value.trim(),deliveryTime:$("deliveryTime").value.trim()},{merge:true});alert("Delivery settings saved.");
}
async function loadDeliverySettings(){const s=await getDoc(doc(db,"settings","delivery"));if(!s.exists())return;const d=s.data();["deliveryCharge2","freeDeliveryAbove","deliveryArea","deliveryTime"].forEach(k=>{const field=$(k);if(field&&d[k]!=null)field.value=d[k]});}

async function adminAddCoupon(){
 if(currentRole!=="admin")return;
 const code=$("couponCode").value.trim().toUpperCase(); if(!code){alert("Coupon code डालें.");return;}
 await addDoc(collection(db,"coupons"),{code,discountPercent:Number($("couponDiscount").value||0),minOrder:Number($("couponMinOrder").value||0),expiry:$("couponExpiry").value,active:true,createdAt:serverTimestamp()});
 ["couponCode","couponDiscount","couponMinOrder","couponExpiry"].forEach(id=>$(id).value="");loadCoupons();
}
function loadCoupons(){const box=$("couponList");if(!box)return;onSnapshot(collection(db,"coupons"),snap=>{box.innerHTML=snap.docs.map(d=>{const c=d.data();return `<div class="card"><b>🎟️ ${escapeHtml(c.code)}</b><p>${Number(c.discountPercent||0)}% off · Min ₹${Number(c.minOrder||0)} · ${escapeHtml(c.expiry||"No expiry")}</p><button class="danger small-btn" onclick="deleteCoupon('${d.id}')">Delete</button></div>`}).join("")||"<p>No coupons.</p>";});}
window.deleteCoupon=async id=>{if(currentRole==="admin"&&confirm("Coupon delete karna hai?"))await deleteDoc(doc(db,"coupons",id));};

async function adminAddBanner(){
 if(currentRole!=="admin")return;
 const title=$("bannerTitle").value.trim(),text=$("bannerText").value.trim();if(!title&&!text){alert("Banner details डालें.");return;}
 await addDoc(collection(db,"banners"),{title,text,image:$("bannerImage").value.trim(),active:true,createdAt:serverTimestamp()});
 $("bannerTitle").value="";$("bannerText").value="";$("bannerImage").value="";loadBanners();
}
function loadBanners(){const box=$("bannerList");if(!box)return;onSnapshot(collection(db,"banners"),snap=>{box.innerHTML=snap.docs.map(d=>{const b=d.data();return `<div class="card"><h3>${escapeHtml(b.title||"")}</h3><p>${escapeHtml(b.text||"")}</p>${b.image?`<img class="admin-thumb" src="${escapeHtml(b.image)}" onerror="this.style.display='none'">`:""}<button class="danger small-btn" onclick="deleteBanner('${d.id}')">Delete</button></div>`}).join("")||"<p>No banners.</p>";});}
window.deleteBanner=async id=>{if(currentRole==="admin"&&confirm("Banner delete karna hai?"))await deleteDoc(doc(db,"banners",id));};

async function generateAdminReport(){
 const box=$("reportSummary");if(!box)return;
 const [o,u,f]=await Promise.all([getDocs(collection(db,"orders")),getDocs(collection(db,"users")),getDocs(collection(db,"foods"))]);
 let sales=0,delivered=0,pending=0;
 o.forEach(x=>{const d=x.data();sales+=Number(d.total||0);if(d.status==="Delivered")delivered++;if(!["Delivered","Cancelled"].includes(d.status||""))pending++;});
 box.innerHTML=`<div class="stats"><div class="stat"><b>${o.size}</b><span>Orders</span></div><div class="stat"><b>₹${sales}</b><span>Sales</span></div><div class="stat"><b>${delivered}</b><span>Delivered</span></div><div class="stat"><b>${pending}</b><span>Open Orders</span></div><div class="stat"><b>${u.size}</b><span>Users</span></div><div class="stat"><b>${f.size}</b><span>Foods</span></div></div>`;
}

function loadAdminOrders(){
 onSnapshot(collection(db,"orders"),async snap=>{
  const box=$("adminOrdersList");if(!box)return;
  const deliveryUsers=await getDeliveryUsers();
  box.innerHTML=snap.docs.map(d=>{const o=d.data();const opts=deliveryUsers.map(u=>`<option value="${u.id}" ${o.deliveryId===u.id?"selected":""}>${escapeHtml(u.name||u.phone||"Delivery")}</option>`).join("");
   return `<div class="card"><b>🧾 ${escapeHtml(o.customerName||"Customer")}</b><p>📱 ${escapeHtml(o.customerPhone||"")} · 🏠 ${escapeHtml(o.address||"")}</p><p>💰 ₹${Number(o.total||0)} · <span class="status">${escapeHtml(o.status||"")}</span></p><select onchange="assignDelivery('${d.id}',this.value)"><option value="">🛵 Assign Delivery</option>${opts}</select><div class="admin-actions"><button class="small-btn" onclick="adminOrderStatus('${d.id}','Order Received')">Received</button><button class="small-btn" onclick="adminOrderStatus('${d.id}','Preparing')">Preparing</button><button class="success small-btn" onclick="adminOrderStatus('${d.id}','Ready for Pickup')">Ready</button><button class="small-btn" onclick="adminOrderStatus('${d.id}','Out for Delivery')">Out for Delivery</button><button class="success small-btn" onclick="adminOrderStatus('${d.id}','Delivered')">Delivered</button><button class="danger small-btn" onclick="adminOrderStatus('${d.id}','Cancelled')">Cancel</button></div></div>`;
  }).join("")||"<p>No orders.</p>";
 });
}




/* =========================================================
   COMMON APP SETTINGS - ALL PANELS
========================================================= */
window.manageAppSetting = async function(kind){
  const statusEls = [
    $("settingsStatus"),
    $("restaurantSettingsStatus"),
    $("deliverySettingsStatus"),
    $("adminSettingsStatus")
  ].filter(Boolean);

  const setStatus = (msg) => {
    statusEls.forEach(el => el.textContent = msg);
  };

  try {
    /* Native Android/WebView bridge, when available. */
    if(window.AndroidApp){
      if(kind === "location" && typeof window.AndroidApp.openAppLocationSettings === "function"){
        window.AndroidApp.openAppLocationSettings();
        setStatus("📍 Location settings opened.");
        return;
      }
      if(kind === "notifications" && typeof window.AndroidApp.openAppNotificationSettings === "function"){
        window.AndroidApp.openAppNotificationSettings();
        setStatus("🔔 Notification settings opened.");
        return;
      }
    }

    if(kind === "location"){
      if(!navigator.geolocation){
        setStatus("📍 This browser/app does not support location.");
        return;
      }
      setStatus("📍 Location permission request ho rahi hai...");
      navigator.geolocation.getCurrentPosition(
        function(pos){
          localStorage.setItem("appLastLatitude", String(pos.coords.latitude));
          localStorage.setItem("appLastLongitude", String(pos.coords.longitude));
          setStatus("✅ Location permission allowed. Current location detected.");
        },
        function(err){
          if(err && err.code === 1){
            setStatus("📍 Location permission blocked. Phone Settings → Apps → Maa Annapurna → Permissions → Location → Allow.");
          }else{
            setStatus("📍 Location nahi mil rahi. Phone Location/GPS ON karke dobara try karein.");
          }
        },
        {enableHighAccuracy:true, timeout:15000, maximumAge:0}
      );
      return;
    }

    if(kind === "notifications"){
      if(!("Notification" in window)){
        setStatus("🔔 Notifications is browser/app mein supported nahi hain.");
        return;
      }
      if(Notification.permission === "granted"){
        setStatus("✅ Notifications already allowed hain.");
        return;
      }
      if(Notification.permission === "denied"){
        setStatus("🔔 Notifications blocked hain. Phone Settings → Apps → Maa Annapurna → Notifications → Allow.");
        return;
      }
      const permission = await Notification.requestPermission();
      setStatus(permission === "granted" ? "✅ Notifications allowed." : "🔔 Notifications permission allow nahi hui.");
      return;
    }
  } catch(e){
    setStatus("⚠️ Settings open nahi ho paayi. Phone Settings se permission allow karein.");
  }
};

/* =========================================================
   STARTUP
========================================================= */

renderCart();

</script>

