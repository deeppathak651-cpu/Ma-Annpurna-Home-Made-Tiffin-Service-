/* =========================================================
   ADMIN ADD FOOD
========================================================= */

window.adminAddFood =
async function(){

  if(currentRole!=="admin")
    return;


  const name =
    $("foodName").value.trim();

  const price =
    Number($("foodPrice").value);

  const emoji =
    $("foodEmoji").value.trim() ||
    "🍱";


  if(!name || !price){

    alert(
      "Food name aur price डालें."
    );

    return;
  }


  await addDoc(
    collection(db,"foods"),
    {

      name:name,

      price:price,

      emoji:emoji,

      active:true,

      createdAt:
        serverTimestamp()

    }
  );


  $("foodName").value="";
  $("foodPrice").value="";
  $("foodEmoji").value="";

};


