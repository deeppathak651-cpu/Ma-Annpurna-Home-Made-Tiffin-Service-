        <input id="bannerImage" placeholder="Image URL (optional)">
        <button class="full" onclick="adminAddBanner()">➕ Add Banner</button>
        <div id="bannerList"></div>
      </div>
    </div>

    <div id="adminReviews" class="admin-section" style="display:none">
      <div class="banner"><h3>⭐ Reviews & Ratings</h3><div id="reviewList"><p>Reviews collection available for future customer reviews.</p></div></div>
    </div>

    <div id="adminStaff" class="admin-section" style="display:none">
      <div class="banner"><h3>👥 Staff Control</h3><p>Restaurant aur Delivery staff ko approve, disable aur permissions dein.</p><div id="staffList"></div></div>
    </div>

    <div id="adminSettings" class="admin-section" style="display:none">
      <div class="banner">
        <h3>⚙️ Business Settings</h3>
        <div class="admin-control-grid">
          <input id="businessName" placeholder="Business Name" value="Maa Annapurna">
          <input id="serviceArea" placeholder="Service Area" value="Haldwani Only">
          <input id="contactNumber" placeholder="Contact Number">
          <input id="whatsappNumber" placeholder="WhatsApp Number">
          <input id="deliveryCharge" type="number" placeholder="Delivery Charge ₹">
          <input id="minOrder" type="number" placeholder="Minimum Order ₹">
          <input id="businessAddress" placeholder="Business Address">
          <input id="businessHours" placeholder="Opening Hours">
        </div>
        <input id="offerText" placeholder="🎁 Special Offer">
        <button class="full" onclick="saveBusinessSettings()">💾 Save Business Settings</button>
      </div>
      <div class="banner app-settings-card">
        <h3>⚙️ App Permissions</h3>
        <p class="muted">Admin panel ke liye location aur notifications manage karein.</p>
        <div class="two-grid">
          <button type="button" onclick="manageAppSetting('location')">📍 Manage Location</button>
          <button type="button" onclick="manageAppSetting('notifications')">🔔 Manage Notifications</button>
        </div>
        <div id="adminSettingsStatus" class="location-text" style="margin-top:10px"></div>
      </div>

      <div class="banner">
        <h3>🔐 Admin Account</h3>
        <p>Admin signup public nahi hai. Firebase Authentication se protected admin account use karein.</p>
      </div>
    </div>

    <div id="adminReports" class="admin-section" style="display:none">
      <div class="banner">
        <h3>📈 Reports</h3>
        <div id="reportSummary"></div>
        <button onclick="generateAdminReport()">🔄 Refresh Report</button>
      </div>
    </div>

    <button class="danger full" onclick="logoutUser()">🚪 Admin Logout</button>
  </div>
</div>

